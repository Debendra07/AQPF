PORT=5000

# Start mongod with --replSet rs0, then run rs.initiate() in mongosh.
MONGODB_URI=mongodb://127.0.0.1:27017/aqpf?replicaSet=rs0

NODE_ENV=development

JWT_SECRET=aqpf_super_secret_change_this_later
JWT_EXPIRES_IN=7d

DELIVERY_FEE=40

# Razorpay test-mode configuration
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_with_test_secret

# Replace these placeholders before running npm run seed:manager.
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD

MANAGER_REGISTRATION_CODE=AQPF-MANAGER-2026